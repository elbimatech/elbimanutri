# Neon Auth Configuration
# Obtenha estas credenciais no painel do Neon Console (Auth & Database)
VITE_NEON_AUTH_URL=https://ep-your-endpoint-id.neonauth.c-2.sa-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_URL=https://ep-your-endpoint-id.neonauth.c-2.sa-east-1.aws.neon.tech/neondb/auth

# Neon Database Connection
# IMPORTANTE: Configure estas variáveis de ambiente na Vercel (Project Settings > Environment Variables)
VITE_DATABASE_URL=postgresql://neondb_owner:YOUR_DATABASE_PASSWORD@ep-your-endpoint-id-pooler.c-2.sa-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_DATABASE_PASSWORD@ep-your-endpoint-id-pooler.c-2.sa-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Google Gemini API Key (Prompt 6 - Geração de Plano Alimentar com IA)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
